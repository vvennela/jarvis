# Live-provider configuration. Never commit actual values.
TYPESAFE_API_KEY=
CRUSOE_API_KEY=
# You.com public research and verified Spotify artist lookup.
YOU_API_KEY=

# Published Crusoe model ID; verify access with your account before live use.
JARVIS_CONVERSATION_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
JARVIS_WORKER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Local file, not an API key. Use a whisper.cpp-compatible model.
JARVIS_WHISPER_MODEL_PATH=
# Local sherpa-onnx streaming Jarvis keyword model directory.
JARVIS_KWS_MODEL_DIR=
JARVIS_VAD_MODEL_PATH=
# Optional exact macOS input name; empty follows changes to the system default microphone.
JARVIS_MICROPHONE_NAME=

# Optional natural voice output.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
